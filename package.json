{
  "name": "quantact-partners-site",
  "version": "1.0.0",
  "private": true,
  "description": "Quantact Partners website and case-study build",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-case-studies.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "audit": "npm audit --omit=dev && node scripts/check-exposure.mjs",
    "serve": "python3 -m http.server 8000 --directory dist",
    "vendor:three": "esbuild node_modules/three/build/three.module.js --bundle --minify --format=esm --target=es2020 --legal-comments=inline --outfile=assets/vendor/three.module.min.js"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "js-yaml": "^5.4.2",
    "marked": "^18.0.14",
    "sanitize-html": "^2.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  }
}
